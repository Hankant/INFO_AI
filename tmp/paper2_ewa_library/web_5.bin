, "latest_html": "https://authors.library.caltech.edu/records/kgnbx-e2z22/latest", "versions": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/versions", "draft": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/draft", "access_links": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/access/links", "access_grants": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/access/grants", "access_users": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/access/users", "access_request": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/access/request", "access": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/access", "communities": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/communities", "communities-suggestions": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/communities-suggestions", "requests": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/requests"}, "revision_id": 8, "parent": {"id": "d638y-sq310", "access": {"owned_by": {"user": "13"}, "settings": {"allow_user_requests": false, "allow_guest_requests": false, "accept_conditions_text": null, "secret_link_expiration": 0}}, "communities": {"ids": ["aedd135f-227e-4fdf-9476-5b3fd011bac6"], "default": "aedd135f-227e-4fdf-9476-5b3fd011bac6", "entries": [{"id": "aedd135f-227e-4fdf-9476-5b3fd011bac6", "created": "2023-08-18T22:58:03.731607+00:00", "updated": "2025-10-07T17:50:38.400491+00:00", "links": {}, "revision_id": 7, "slug": "caltechauthors", "metadata": {"title": "CaltechAUTHORS", "description": "CaltechAUTHORS contains research publications by Caltech faculty and other Caltech researchers. Most items in CaltechAUTHORS are articles, but there are also books, book chapters, conference papers and more. The repository is updated continuously through library and campus efforts.", "page": "<p>CaltechAUTHORS contains research publications by Caltech faculty and other Caltech researchers. Most items in CaltechAUTHORS are articles, but there are also books, book chapters, conference papers and more. The repository is updated continuously as departments and library staff add available and recently published documents.</p>"}, "access": {"visibility": "public", "members_visibility": "public", "member_policy": "open", "record_submission_policy": "open", "review_policy": "closed"}, "custom_fields": {}, "deletion_status": {"is_deleted": false, "status": "P"}, "children": {"allow": false}}]}, "pids": {}}, "versions": {"is_latest": true, "index": 1}, "is_published": true, "is_draft": false, "pids": {"doi": {"identifier": "10.1111/1468-0262.00054", "provider": "external"}, "oai": {"identifier": "oai:authors.library.caltech.edu:kgnbx-e2z22", "provider": "oai"}}, "metadata": {"resource_type": {"id": "publication-article", "title": {"de": "Zeitschriftenartikel", "en": "Journal Article"}}, "creators": [{"person_or_org": {"type": "personal", "name": "Camerer, Colin F.", "given_name": "Colin F.", "family_name": "Camerer", "identifiers": [{"identifier": "Camerer-C-F", "scheme": "clpid"}, {"identifier": "0000-0003-4049-1871", "scheme": "orcid"}]}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Ho, Teck Hua", "given_name": "Teck Hua", "family_name": "Ho", "identifiers": [{"identifier": "Ho-Teck-Hua", "scheme": "clpid"}, {"identifier": "0000-0001-5210-4977", "scheme": "orcid"}]}, "affiliations": [{"id": "00b30xv10", "name": "University of Pennsylvania", "identifiers": [{"identifier": "00b30xv10", "scheme": "ror"}]}]}], "title": "Experience-weighted Attraction Learning in Normal Form Games", "publisher": "Econometric Society", "publication_date": "1999-07", "subjects": [{"subject": "Learning, behavioral game theory, reinforcement learning, fictitious play"}], "dates": [{"date": "2011-02-11", "type": {"id": "created", "title": {"de": "Erstellt", "en": "Created"}}, "description": "Created from EPrint's datestamp field"}, {"date": "2021-11-09", "type": {"id": "updated", "title": {"de": "Aktualisiert", "en": "Updated"}}, "description": "Created from EPrint's last_modified field"}], "identifiers": [{"identifier": "22107", "scheme": "eprintid"}, {"identifier": "CaltechAUTHORS:20110210-093101968", "scheme": "resolverid"}], "related_identifiers": [{"identifier": "http://resolver.caltech.edu/CaltechAUTHORS:20170814-161157311", "scheme": "url", "relation_type": {"id": "describes", "title": {"de": "Beschreibt", "en": "Describes"}}}], "version": "Published", "rights": [{"title": {"en": "Other"}, "description": {"en": "No commercial reproduction, distribution, display or performance rights in this work are provided."}}], "description": "In 'experience-weighted attraction' (EWA) learning, strategies have attractions that reflect initial predispositions, are updated based on payoff experience, and determine choice probabilities according to some rule (e.g., logit). A key feature is a parameter \u03b4 that weights the strength of hypothetical reinforcement of strategies that were not chosen according to the payoff they would have yielded, relative to reinforcement of chosen strategies according to received payoffs. The other key features are two discount rates, \u03c6 and \u03c1, which separately discount previous attractions, and an experience weight. EWA includes reinforcement learning and weighted fictitious play (belief learning) as special cases, and hybridizes their key elements. When \u03b4= 0 and \u03c1= 0, cumulative choice reinforcement results. When \u03b4= 1 and \u03c1=\u03c6, levels of reinforcement of strategies are exactly the same as expected payoffs given weighted fictitious play beliefs. Using three sets of experimental data, parameter estimates of the model were calibrated on part of the data and used to predict a holdout sample. Estimates of \u03b4 are generally around .50, \u03c6 around .8 \u2212 1, and \u03c1 varies from 0 to \u03c6. Reinforcement and belief-learning special cases are generally rejected in favor of EWA, though belief models do better in some constant-sum games. EWA is able to combine the best features of previous approaches, allowing attractions to begin and grow flexibly as choice reinforcement does, but reinforcing unchosen strategies substantially as belief-based models implicitly do.", "additional_descriptions": [{"description": "\u00a9 1999 Econometric Society. \n\nManuscript received January, 1997; final revision received August, 1998. Article first published online: 9 Dec. 2003.", "type": {"id": "additional", "title": {"de": "Sonstige", "en": "Additional Information"}}}, {"description": "<p>Published - <a href=\"/records/kgnbx-e2z22/files/1468-0262.00054_1_.pdf?download=1\">1468-0262.00054_1_.pdf</a></p>", "type": {"id": "attached-files", "title": {"de": "Sonstige", "en": "Attached Files"}}}]}, "custom_fields": {"journal:journal": {"title": "Econometrica", "issue": "4", "volume": "67", "pages": "827-874", "issn": "0012-9682"}}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 1, "total_bytes": 477408, "entries": {"1468-0262.00054_1_.pdf": {"id": "df8a0d5b-3cb2-4364-aa08-cc7742bb4110", "checksum": "md5:57b6c027bed81354c368c1d69ad3081f", "ext": "pdf", "size": 477408, "mimetype": "application/pdf", "storage_class": "L", "key": "1468-0262.00054_1_.pdf", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/files/1468-0262.00054_1_.pdf", "content": "https://authors.library.caltech.edu/api/records/kgnbx-e2z22/files/1468-0262.00054_1_.pdf/content", "iiif_canvas": "https://authors.library.caltech.edu/api/iiif/record:kgnbx-e2z22/canvas/1468-0262.00054_1_.pdf", "iiif_base": "https://authors.library.caltech.edu/api/iiif/record:kgnbx-e2z22:1468-0262.00054_1_.pdf", "iiif_info": "https://authors.library.caltech.edu/api/iiif/record:kgnbx-e2z22:1468-0262.00054_1_.pdf/info.json", "iiif_api": "https://authors.library.caltech.edu/api/iiif/record:kgnbx-e2z22:1468-0262.00054_1_.pdf/full/full/0/default.png"}}}}, "media_files": {"enabled": false, "order": [], "count": 0, "total_bytes": 0, "entries": {}}, "status": "published", "deletion_status": {"is_deleted": false, "status": "P"}, "stats": {"this_version": {"views": 152, "unique_views": 152, "downloads": 395, "unique_downloads": 389, "data_volume": 188576160.0}, "all_versions": {"views": 152, "unique_views": 152, "downloads": 395, "unique_downloads": 389, "data_volume": 188576160.0}}}